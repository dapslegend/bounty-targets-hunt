# Copy to operator environment. Never commit real secrets.
# PentAGI login lives in /opt/web3/pentagi/.env — this pack does not need a copy.

INTERVAL_SEC=3600
DISCOVER_EVERY_SEC=300
BATCH_SIZE=3
MAX_ACTIVE_FLOWS=4
MIN_SCORE=20
HUNT_PAYOUT_MIN=500
HUNT_PAYOUT_MAX=50000
MAX_PENDING=400
MAX_ARCHIVE=8000
FORCE_LIVE=1
DRY_RUN=0
# feed clone (public)
BOUNTY_FEED_REPO=https://github.com/arkadiyt/bounty-targets-data.git
